
<section class="audit-history">
    <button class="button button-small" @onclick="ToggleAsync" aria-expanded="@(_expanded ? "true" : "false")" disabled="@_busy">
        @(_expanded ? "Hide history" : "History")
    </button>
    @if (_expanded)
    {
        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
            <button class="button button-small" @onclick="ReloadAsync" disabled="@_busy">Try again</button>
        }
        else if (!_requested)
        {
            <p>Loading…</p>
        }
        else if (_rows.Count == 0)
        {
            <p>Nothing recorded yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th scope="col">When</th><th scope="col">What</th><th scope="col">Who</th><th scope="col">Details</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td data-label="When">@row.Timestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                <td data-label="What" data-role="audit-action">@row.Action</td>
                                <td data-label="Who">@(row.ActorDisplay ?? row.ActorId ?? row.ActorType)</td>
                                <td data-label="Details">@row.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_cursor is not null)
            {
                <button class="button button-small" @onclick="LoadMoreAsync" disabled="@_busy">Load more</button>
            }
        }
    }
</section>
