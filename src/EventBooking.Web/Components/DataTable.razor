@typeparam TItem
<div class="table-wrap">
    @if (Items is null)
    {
        <div class="loading-skeleton" role="status" aria-label="Loading" />
    }
    else if (Items.Count == 0)
    {
        <p>@EmptyTitle</p>
        <p class="muted">@EmptyHint</p>
        @if (!string.IsNullOrEmpty(EmptyActionLabel))
        {
            <button type="button" class="button button-primary" @onclick="() => EmptyAction.InvokeAsync()">@EmptyActionLabel</button>
        }
    }
    else
    {
        var typeCodes = TypeCodes(Items);
        var collapsed = typeCodes.Count > MaximumTypeColumns;
        if (collapsed)
        {
            typeCodes = [];
        }
        <table>
            <thead><tr>
                @foreach (var column in Columns)
                {
                    <th scope="col">@column.Title</th>
                }
                @foreach (var typeCode in typeCodes)
                {
                    <th scope="col" data-type-code="@typeCode">@typeCode</th>
                }
                @if (collapsed)
                {
                    <th scope="col">Capacity</th>
                }
            </tr></thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr @key="RowKey(item)">
                        @foreach (var column in Columns)
                        {
                            <td data-label="@column.Title">@column.Cell(item)</td>
                        }
                        @* One cell per header column, looked up by code, so a row lacking a type
                           leaves that cell empty instead of shifting the rest left. *@
                        @foreach (var typeCode in typeCodes)
                        {
                            <td data-label="@typeCode">@CapacityText(item, typeCode)</td>
                        }
                        @if (collapsed)
                        {
                            <td data-label="Capacity"><ul class="capacity-breakdown">
                                @foreach (var capacity in Capacities(item))
                                {
                                    <li>@capacity.TypeCode: @capacity.TotalHeadcount total, @capacity.RemainingCapacity left</li>
                                }
                            </ul></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (NextCursor is not null)
        {
            <button type="button" class="button" @onclick="() => LoadMore.InvokeAsync()">Load more</button>
        }
    }
</div>
