
<div class="banner banner-@Variant.ToString().ToLowerInvariant()" role="@(Variant is BannerVariant.Error ? "alert" : "status")" aria-live="@(Variant is BannerVariant.Error ? "assertive" : "polite")">
    <p>@Message</p>
    @if (Retry.HasDelegate)
    {
        <p><button type="button" class="button" @onclick="() => Retry.InvokeAsync()">Try again</button></p>
    }
</div>
