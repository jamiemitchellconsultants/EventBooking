@inherits LayoutComponentBase
@inject MeClient Me
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
@inject ProductOptions Product

<div class="app-shell">
    <CascadingValue Value="_me">
        <AuthorizeView>
            <Authorized>
                <header class="topbar">
                    <div class="brand-lockup">
                        <BrandMark />
                        <NavLink class="brand" href="" Match="NavLinkMatch.All">@Product.ProductName</NavLink>
                    </div>
                    <div class="topbar-signin">
                        @if (context.User.Identity?.Name is { } name)
                        {
                            <span>Signed in as @name</span>
                        }
                        <button type="button" class="button" @onclick="SignOut">Sign out</button>
                    </div>
                </header>
                @if (_me?.Value is { } me && StaffNavigation.LinksFor(me) is { Count: > 0 } links)
                {
                    <nav class="staff-nav" aria-label="Staff pages">
                        @foreach (var link in links)
                        {
                            <NavLink class="staff-nav-link" href="@link.Href">@link.Label</NavLink>
                        }
                    </nav>
                }
                <main class="main-content">
                    @if (_me is null)
                    {
                        <p role="status">Loading…</p>
                    }
                    else
                    {
                        @Body
                    }
                </main>
            </Authorized>
            <NotAuthorized>
                <header class="topbar">
                    <div class="brand-lockup">
                        <BrandMark />
                        <NavLink class="brand" href="" Match="NavLinkMatch.All">@Product.ProductName</NavLink>
                    </div>
                    <div class="topbar-signin">
                        <a href="authentication/login">Sign in</a>
                    </div>
                </header>
                <main class="main-content">
                    @Body
                </main>
            </NotAuthorized>
        </AuthorizeView>
        <footer class="app-footer">
            <span>@Product.ProductName</span>
            <NavLink href="/help">Help</NavLink>
        </footer>
    </CascadingValue>
</div>

@code {
    private ApiOutcome<MeDto>? _me;

    protected override async Task OnInitializedAsync() =>
        _me = await Me.GetAsync(CancellationToken.None);

    private void SignOut() => Navigation.NavigateToLogout("authentication/logout");
}
