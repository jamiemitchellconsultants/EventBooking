<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <!-- The E2E compile-time provider exists only in a publish carrying EventBookingE2E.
       Defining the symbol through a property keeps the framework's own constants intact,
       which -p:DefineConstants=EVENTBOOKING_E2E would wipe. -->
  <PropertyGroup Condition="'$(EventBookingE2E)' == 'true'">
    <DefineConstants>$(DefineConstants);EVENTBOOKING_E2E</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <!-- The role guides under wwwroot/help are plain static content: the Help page fetches
         them at runtime from the app's own origin. If the production host serves this
         bundle behind nginx try_files, the /help directory needs an explicit fallback to
         index.html — otherwise try_files matches the directory before the SPA fallback and
         301-redirects the client-side /help route to a trailing slash. -->
    <!-- The shared design-system sheet lives beside the components and is served from
         the app bundle's css path. -->
    <Content Include="Components\components.css">
      <Link>wwwroot\css\components.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
