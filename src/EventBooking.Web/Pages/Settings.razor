@page "/admin/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>System settings</PageTitle>
<section class="page settings-page" aria-labelledby="settings-heading" aria-busy="@(_loading || _busy ? "true" : "false")">
<div class="page-header"><div><span class="eyebrow">Administration</span><h1 id="settings-heading">System settings</h1><p>Invitation timing for future invitations only. Saved changes never rewrite invitations already sent.</p></div></div>
@if (_error is not null) { <Banner Variant="BannerVariant.Error" Message="@_error" Retry="LoadAsync" /> }
@if (_conflictVersion is not null) { <Banner Variant="BannerVariant.Warning" Message="@($"Another Admin changed these settings. The server is now on version {_conflictVersion} — your values are still here; review them and save again.")" /> }
@if (_loading) { <p role="status">Loading…</p> }
else if (_form is not null)
{
<section class="card" aria-labelledby="timing-heading"><h2 id="timing-heading">Invitation timing</h2>
<label class="field">Invitation expiry (days)<input id="invite-expiry-days" type="number" min="1" max="60" @bind="_form.InviteExpiryDays" /></label>
<label class="field">Automatic retries<input id="max-auto-retries" type="number" min="0" max="10" @bind="_form.MaxAutoRetryCount" /></label>
<label class="field">Options per invitation<input id="invite-option-count" type="number" min="1" max="5" @bind="_form.InviteOptionCount" /></label>
<label class="field">Self-registration confirmation window (hours)<input id="registration-expiry-hours" type="number" min="1" max="168" @bind="_form.PendingRegistrationExpiryHours" /></label>
<div class="row-actions"><button class="button button-primary" disabled="@_busy" @onclick="SaveAsync">Save changes</button></div></section>
}
</section>
