@page "/admin/appointment-types"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Appointment types</PageTitle>
<section class="page" aria-labelledby="types-heading" aria-busy="@(_loading || _busy ? "true" : "false")">
<header class="page-header"><div><span class="eyebrow">Administration</span><h1 id="types-heading">Appointment types</h1></div>
@if (_canCreate) { <button class="button button-primary" @onclick="New">New appointment type</button> }</header>
@if (_error is not null) { <Banner Variant="BannerVariant.Error" Message="@_error" Retry="LoadAsync" /> }
@if (_conflictVersion is not null) { <Banner Variant="BannerVariant.Warning" Message="@($"Another Admin changed this appointment type. The server is now on version {_conflictVersion} — your values are still here; review them and save again.")" /> }
<DataTable TItem="AppointmentTypeDto" Items="@(_loading ? null : _rows)" RowKey="x => x.Id" EmptyTitle="No appointment types yet." EmptyActionLabel="@(_canCreate ? "Add a type before creating groups or proposals." : "")" EmptyAction="New" Columns="@Columns" />
@if (_edit is not null) { <section class="card" aria-labelledby="type-editor"><h2 id="type-editor">@(_creating ? "New appointment type" : $"Edit {_edit.Code}")</h2>@if (_creating) { <label class="field">Code<input name="code" @bind="_edit.Code" /></label> }<label class="field">Name<input name="name" @bind="_edit.Name" /></label><label><input type="checkbox" @bind="_edit.IsActive" /> Active</label><div class="row-actions"><button class="button" @onclick="Cancel">Cancel</button><button data-action="save" class="button button-primary" disabled="@_busy" @onclick="SaveAsync">Save</button></div></section> }
</section>
