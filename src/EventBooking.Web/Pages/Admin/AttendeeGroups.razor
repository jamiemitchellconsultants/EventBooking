@page "/admin/attendee-groups"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Attendee groups</PageTitle>
<section class="page" aria-labelledby="groups-heading" aria-busy="@(_loading || _busy ? "true" : "false")">
<header class="page-header"><div><span class="eyebrow">Administration</span><h1 id="groups-heading">Attendee groups</h1></div>
@if (_canCreate) { <button class="button button-primary" @onclick="New">New attendee group</button> }</header>
@if (_error is not null) { <Banner Variant="BannerVariant.Error" Message="@_error" Retry="LoadAsync" /> }
@if (_conflictVersion is not null) { <Banner Variant="BannerVariant.Warning" Message="@($"Another Admin changed this attendee group. The server is now on version {_conflictVersion} — your values are still here; review them and save again.")" /> }
<DataTable TItem="AttendeeGroupDto" Items="@(_loading ? null : Rows)" RowKey="x=>x.Id" EmptyTitle="No attendee groups yet." EmptyActionLabel="@(_canCreate ? "Add a group and at least one required type." : "")" EmptyAction="New" Columns="@Columns" />
@if (_edit is not null){<section class="card" aria-labelledby="group-editor"><h2 id="group-editor">@(_creating ? "New attendee group" : $"Edit {_edit.Code}")</h2>@if(_creating){<label class="field">Code<input name="code" @bind="_edit.Code" /></label>}<label class="field">Name<input name="name" @bind="_edit.Name" /></label><label class="field">Description<textarea name="description" maxlength="500" @bind="_edit.Description"></textarea></label><TypePicker Options="@TypeOptions" SelectedIds="@_edit.RequirementTypeIds" SelectedIdsChanged="ids=>_edit.RequirementTypeIds=ids" /><label><input type="checkbox" @bind="_edit.IsActive" /> Active</label>@if(_confirm){<Banner Variant="BannerVariant.Warning" Message="@($"This changes requirements for {_edit.MemberCount} attendees and replaces their pending invitations.")" /><div class="row-actions"><button class="button" @onclick="Cancel">Cancel</button><button class="button button-primary" @onclick="SaveConfirmedAsync">Confirm and save</button></div>}else{<div class="row-actions"><button class="button" @onclick="Cancel">Cancel</button><button data-action="save" class="button button-primary" disabled="@_busy" @onclick="RequestSaveAsync">Save</button></div>}</section>}
</section>
