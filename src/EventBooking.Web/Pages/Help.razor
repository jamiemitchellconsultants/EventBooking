@page "/help"

<PageTitle>Help</PageTitle>

<section class="page help-page" aria-labelledby="help-heading" aria-busy="@(_loading ? "true" : "false")">
    <div class="page-header">
        <div>
            <span class="eyebrow">User guide</span>
            <h1 id="help-heading">Help</h1>
            <p>@(_authenticated ? "Guidance for the roles on your profile." : "Guidance for booking and managing your appointment.")</p>
        </div>
    </div>

    @if (_loading)
    {
        <div class="card loading-block" role="status">
            <span class="loading-line loading-line-short"></span>
            <span class="loading-line"></span>
            <span class="loading-line loading-line-medium"></span>
            <span class="visually-hidden">Loading…</span>
        </div>
    }
    else if (_error is not null)
    {
        <p class="landing-hint" role="alert">@_error</p>
        <button class="button" @onclick="LoadAsync">Try again</button>
    }
    else if (_sections.Count == 0)
    {
        <p class="landing-hint">
            Your account has not been assigned a role yet. Contact an administrator to be given
            access as Manager, Coordinator, Admin, or Appointment staff.
        </p>
    }
    else
    {
        <nav class="card guide-toc" aria-label="Contents">
            <h2>Contents</h2>
            <ul>
                @foreach (var section in _sections)
                {
                    <li><a href="@(SectionHref(section))">@(section.Title)</a></li>
                }
            </ul>
        </nav>

        @foreach (var section in _sections)
        {
            <section class="card guide-section" id="@(section.AnchorId)" aria-label="@(section.Title)">
                @((MarkupString)section.Html)
            </section>
        }
    }
</section>
