@page "/event-groups/{GroupId:guid}/events/{EventId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout EventBooking.Web.Layout.AttendeeLayout

<PageTitle>Request a place</PageTitle>

<section class="public-registration-page" aria-busy="@(_loading || _busy)">
    @if (_loading)
    {
        <div class="public-registration-page__status" aria-label="Loading event">
            <span class="loading-line loading-line-short"></span>
            <span class="loading-line"></span>
            <span class="loading-line loading-line-medium"></span>
        </div>
    }
    else if (_sent)
    {
        <div class="public-registration-page__intro">
            <h1>Check your email</h1>
        </div>
        <div class="public-registration-page__status">
            <p class="public-registration-page__note" role="status">If that address can receive mail, a confirmation link is on its way. Use the link before it expires to confirm your place.</p>
        </div>
    }
    else if (_event is null || _group is null)
    {
        <div class="public-registration-page__intro">
            <h1>We couldn’t find that time</h1>
        </div>
        <div class="public-registration-page__status">
            <p class="public-registration-page__banner" role="alert">@(_error ?? "This time is no longer open.")</p>
            <p class="public-registration-page__note">If you need help, contact @CoordinatorContact.</p>
        </div>
    }
    else
    {
        <div class="public-registration-page__intro">
            <h1>@_group.Title</h1>
            <p class="public-registration-page__lead">@_group.Description</p>
        </div>

        <div class="public-registration-page__card">
            <span class="public-registration-page__label">Your time</span>
            <span class="public-registration-page__window">@_event.LocationName, @_event.Address · @_event.Date.ToString("dddd, dd MMM yyyy") · @_event.StartTime.ToString("HH\\:mm")</span>
            <span class="public-registration-page__types">@string.Join(" and ", _event.AppointmentTypeNames)</span>
        </div>

        @if (_error is not null)
        {
            <p class="public-registration-page__banner" role="alert">@_error</p>
        }

        <div class="public-registration-page__field">
            <label for="registration-name">Full name</label>
            <input id="registration-name" name="name" type="text" value="@_name"
                   @onchange="(e => _name = e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="public-registration-page__field">
            <label for="registration-email">Email address</label>
            <input id="registration-email" name="email" type="email" value="@_email"
                   @onchange="(e => _email = e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="public-registration-page__field">
            <label for="registration-group">Your group</label>
            <select id="registration-group" name="attendee-group" value="@_attendeeGroupId"
                    @onchange="(e => _attendeeGroupId = e.Value?.ToString() ?? string.Empty)">
                <option value="">Choose your group…</option>
                @foreach (var choice in _group.AttendeeGroups)
                {
                    var open = _event.AvailableAttendeeGroupIds.Contains(choice.Id);
                    <option value="@choice.Id.ToString("D")" title="@choice.Description" disabled="@(!open)">@choice.Name@(open ? "" : " (full)")</option>
                }
            </select>
        </div>

        <p class="public-registration-page__note">Sending this request does not hold a place. Your place is booked only when you confirm through the email link.</p>

        <div class="public-registration-page__actions">
            <button data-action="send-request" class="public-registration-page__button public-registration-page__button--primary"
                    @onclick="SendAsync" disabled="@_busy">@(_busy ? "Sending…" : "Send request")</button>
        </div>
    }
</section>
