@page "/event-groups"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Event groups</PageTitle>
<section class="page" aria-labelledby="groups-heading" aria-busy="@((_loading || _busy) ? "true" : "false")">
    <header class="page-header">
        <div>
            <span class="eyebrow">Self-registration</span>
            <h1 id="groups-heading">Event groups</h1>
        </div>
        @if (_canCreate)
        {
            <button class="button button-primary" data-action="new" @onclick="New">New event group</button>
        }
    </header>
    @if (_error is not null)
    {
        <Banner Variant="BannerVariant.Error" Message="@_error" Retry="LoadAsync" />
    }
    @if (_conflictVersion is not null)
    {
        <Banner Variant="BannerVariant.Warning" Message="@($"Another staff member changed this event group. The server is now on version {_conflictVersion} — your values are still here; review them and save again.")" />
    }
    <DataTable TItem="EventGroupDto" Items="@(_loading ? null : Rows)" RowKey="x => x.Id" EmptyTitle="No event groups yet." EmptyActionLabel="@(_canCreate ? "Publish a group of compatible events." : "")" EmptyAction="New" Columns="@Columns" />
    @if (_edit is not null)
    {
        <section class="card" aria-labelledby="group-editor">
            <h2 id="group-editor">@(_creating ? "New event group" : $"Edit {_edit.Title}")</h2>
            <label class="field">Title<input name="title" @bind="_edit.Title" maxlength="160" /></label>
            <label class="field">Description<textarea name="description" maxlength="2000" @bind="_edit.Description"></textarea></label>
            <fieldset class="field">
                <legend>Eligible attendee groups</legend>
                @foreach (var option in GroupOptions)
                {
                    <label><input type="checkbox" name="attendee-group" value="@option.Id" checked="@_edit.AttendeeGroupIds.Contains(option.Id)" @onchange="e => ToggleGroup(option.Id, (bool)e.Value!)" /> @option.Name</label>
                }
            </fieldset>
            <p class="muted">Appointment types: @DerivedTypeNames(_edit)</p>
            <label><input type="checkbox" name="group-open" @bind="_edit.IsOpen" /> Open group for registration</label>
            <div class="row-actions">
                <button class="button" @onclick="Cancel">Cancel</button>
                <button data-action="save" class="button button-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
            </div>
            @if (!_creating)
            {
                <h3>Member events</h3>
                <p class="muted">Shareable link: @(Nav.BaseUri.TrimEnd('/') + "/event-groups/" + _edit.Id)</p>
                <ul class="member-list">
                    @foreach (var member in _edit.Events)
                    {
                        <li>
                            <span>@EventLabel(member.EventId)</span>
                            <label><input type="checkbox" name="member-open" value="@member.EventId" checked="@member.IsOpen" @onchange="e => ToggleMemberAsync(member.EventId, (bool)e.Value!)" /> Open registration for this event</label>
                            <button class="button" data-action="remove-event" data-event="@member.EventId" @onclick="() => RemoveEventAsync(member.EventId)">Remove</button>
                        </li>
                    }
                </ul>
                <div class="row-actions">
                    <select name="add-event" @bind="_candidateEventId">
                        <option value="">Add an event…</option>
                        @foreach (var candidate in CandidateEvents())
                        {
                            <option value="@candidate.Id" disabled="@(!candidate.Compatible)">@candidate.Label</option>
                        }
                    </select>
                    <button class="button" data-action="add-event" disabled="@(_candidateEventId is null || _adding)" @onclick="AddEventAsync">Add event</button>
                </div>
                @if (_candidateNote is not null)
                {
                    <p class="muted">@_candidateNote</p>
                }
            }
        </section>
    }
</section>
