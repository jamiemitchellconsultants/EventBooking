@page "/events/operations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Event operations</PageTitle>
<section class="page event-operations" aria-labelledby="operations-heading" aria-busy="@(_loading || _busy ? "true" : "false")">
<div class="page-header"><div><span class="eyebrow">Operations</span><h1 id="operations-heading">Event operations</h1><p>Active events whose windows have not started. Cancelling re-invites the affected attendees.</p></div></div>
@if (_error is not null) { <Banner Variant="BannerVariant.Error" Message="@_error" Retry="LoadFirstPageAsync" /> }
@if (_confirmation is not null) { <Banner Variant="BannerVariant.Success" Message="@_confirmation" /> }
<div class="row-actions">
<label class="field">Location<select name="location" @onchange="OnLocationFilterChanged"><option value="">All locations</option>@foreach (var location in _knownLocations) { <option value="@location.Id" selected="@(_locationId == location.Id)">@location.Name</option> }</select></label>
<label class="field">From<input name="from" type="date" @bind="_from" @bind:after="LoadFirstPageAfterFilterAsync" /></label>
<label class="field">To<input name="to" type="date" @bind="_to" @bind:after="LoadFirstPageAfterFilterAsync" /></label>
</div>
@if (_loading) { <p role="status">Loading…</p> }
else if (_events.Count == 0) { <p>No events found.</p> }
else
{
<div class="table-wrap"><table>
<thead><tr><th scope="col">Location</th><th scope="col">When</th><th scope="col">Types</th><th scope="col">Bookings</th><th scope="col">Actions</th></tr></thead>
<tbody>
@foreach (var evt in _events)
{
<tr>
<td data-label="Location">@evt.LocationName</td>
<td data-label="When"><EventTime Value="@evt.Time" /></td>
<td data-label="Types"><span class="chip-row">@foreach (var capacity in evt.Capacities) { <span><TypeChip Code="@capacity.Code" Name="@capacity.Name" /> @capacity.RemainingCapacity of @capacity.TotalHeadcount left</span> }</span></td>
<td data-label="Bookings">@evt.ActiveBookings active</td>
<td data-label="Actions">
@if (evt.Links.Allows("cancel"))
{
    if (_arming == evt.Id)
    {
        <p role="status">@(evt.ActiveBookings == 1 ? "Cancel 1 active booking?" : $"Cancel {evt.ActiveBookings} active bookings?")</p>
        <span class="row-actions"><button class="button" @onclick="() => _arming = null">Keep event</button><button data-action="confirm-cancel-event" class="button button-danger" disabled="@_busy" @onclick="() => ConfirmCancelAsync(evt)">Confirm cancellation</button></span>
    }
    else
    {
        <button data-action="cancel-event" class="button button-danger" disabled="@_busy" @onclick="() => _arming = evt.Id">Cancel event</button>
    }
}
else
{
    <span class="hint">Event already started</span>
}
</td>
</tr>
}
</tbody>
</table></div>
@if (_cursor is not null) { <button class="button" disabled="@_busy" @onclick="LoadMoreAsync">Load more</button> }
}
</section>
