@page "/admin/staff-access"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Staff access</PageTitle>
<section class="page staff-access-page" aria-labelledby="staff-access-heading" aria-busy="@(_loading || _busy ? "true" : "false")">
<div class="page-header"><div><span class="eyebrow">Administration</span><h1 id="staff-access-heading">Staff access</h1><p>Appointment-type scope per staff profile. Roles are set elsewhere and shown here read-only.</p></div></div>
@if (_error is not null) { <Banner Variant="BannerVariant.Error" Message="@_error" Retry="LoadAsync" /> }
@if (_confirmation is not null) { <Banner Variant="BannerVariant.Success" Message="@_confirmation" /> }
@if (_loading) { <p role="status">Loading…</p> }
else if (_rows.Count == 0) { <p>No staff profiles yet.</p> }
else
{
<div class="table-wrap"><table>
<thead><tr><th scope="col">Staff</th><th scope="col">Roles</th><th scope="col">Scope</th><th scope="col">Change scope</th></tr></thead>
<tbody>
@foreach (var profile in _rows)
{
<tr>
<td data-label="Staff">@(profile.DisplayName ?? profile.StaffId ?? profile.StaffUserId.ToString())</td>
<td data-label="Roles"><span class="chip-row">@foreach (var role in profile.Roles) { <span class="role-chip">@role</span> }</span></td>
<td data-label="Scope">@ScopeName(profile.AppointmentTypeId)</td>
<td data-label="Change scope">
@if (profile.Links.Allows("setScope"))
{
<select aria-label="@($"Scope for {profile.DisplayName ?? profile.StaffId}")" @bind="_scope[profile.StaffUserId]">
<option value="">No scope</option>
@foreach (var option in _options) { <option value="@option.Id">@option.Name</option> }
</select>
<button data-action="save-scope" class="button" disabled="@_busy" @onclick="() => SaveAsync(profile)">Save scope</button>
}
</td>
</tr>
}
</tbody>
</table></div>
}
</section>
