@page "/event-groups/confirm/{Token}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout EventBooking.Web.Layout.AttendeeLayout

<PageTitle>Confirm your place</PageTitle>

<section class="confirm-registration-page" aria-busy="@(_loading || _busy)">
    @if (_loading)
    {
        <div class="confirm-registration-page__status" aria-label="Loading registration">
            <span class="loading-line loading-line-short"></span>
            <span class="loading-line"></span>
            <span class="loading-line loading-line-medium"></span>
        </div>
    }
    else if (_confirmed)
    {
        <div class="confirm-registration-page__intro">
            <h1>Your place is booked</h1>
        </div>
        <div class="confirm-registration-page__status">
            <p class="confirm-registration-page__note" role="status">Check the booking-confirmation email for your manage link.</p>
        </div>
    }
    else if (_summary is null)
    {
        <div class="confirm-registration-page__intro">
            <h1>We couldn’t open that link</h1>
        </div>
        <div class="confirm-registration-page__status">
            <p class="confirm-registration-page__banner" role="alert">@(_error ?? "This confirmation link is invalid.")</p>
            <p class="confirm-registration-page__note">If you need help, contact @CoordinatorContact.</p>
        </div>
    }
    else
    {
        <div class="confirm-registration-page__intro">
            <h1>@_summary.EventGroupTitle</h1>
            <p class="confirm-registration-page__lead">Confirm your place for @_summary.AttendeeGroupName.</p>
        </div>

        <div class="confirm-registration-page__card">
            <span class="confirm-registration-page__label">Your time</span>
            <span class="confirm-registration-page__window">@_summary.LocationName · @_summary.Date.ToString("dddd, dd MMM yyyy") · @_summary.StartTime.ToString("HH\\:mm")</span>
        </div>

        @if (_error is not null)
        {
            <p class="confirm-registration-page__banner" role="alert">@_error</p>
            <p class="confirm-registration-page__note">If you need help, contact @CoordinatorContact.</p>
        }

        <div class="confirm-registration-page__actions">
            <button data-action="confirm-registration" class="confirm-registration-page__button confirm-registration-page__button--primary"
                    @onclick="ConfirmAsync" disabled="@_busy">@(_busy ? "Confirming…" : "Confirm my place")</button>
        </div>
    }
</section>
