@page "/appointments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Appointments</PageTitle>
<section class="page appointments-workspace" aria-labelledby="appointments-heading" aria-busy="@(_loading || _busy ? "true" : "false")">
<div class="page-header"><div><span class="eyebrow">Appointment workspace</span><h1 id="appointments-heading">Appointments@(_context is not null ? $" — {_context.ScopeTypeName}" : "")</h1></div>
@if (_selectedEventId is not null) { <button type="button" data-action="download-roster" class="button" disabled="@_downloading" @onclick="DownloadRosterAsync">@(_downloading ? "Preparing…" : "Download roster (CSV)")</button> }</div>
@if (_error is not null) { <Banner Variant="BannerVariant.Error" Message="@_error" Retry="LoadAsync" /> }
@if (_announcement is not null) { <Banner Variant="BannerVariant.Info" Message="@_announcement" /> }
@if (_loading) { <p role="status">Loading…</p> }
else if (_events.Count == 0) { <p>No events for your appointment type.</p> }
else
{
<label class="field">Event<select name="event" @onchange="OnEventChanged">
@foreach (var group in _events.GroupBy(x => x.LocationName).OrderBy(x => x.Key, StringComparer.Ordinal))
{
<optgroup label="@group.Key">
@foreach (var evt in group) { <option value="@evt.EventId" selected="@(_selectedEventId == evt.EventId)">@EventLabel(evt)</option> }
</optgroup>
}
</select></label>
@if (_rosterLoading) { <p role="status">Loading roster…</p> }
else if (_rows.Count == 0) { <p>No appointments on this event yet.</p> }
else
{
<div class="table-wrap"><table>
<thead><tr><th scope="col">Attendee</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
<tbody>
@foreach (var row in _rows)
{
<tr>
<td data-label="Attendee">@row.Name</td>
<td data-label="Status"><StatusBadge Value="@row.AppointmentStatus" Display="@StatusDisplay(row.AppointmentStatus)" /></td>
<td data-label="Actions"><span class="row-actions">
@if (row.Links.Allows("checkIn")) { <button data-action="check-in" class="button" disabled="@_busy" @onclick="@(() => SetStatusAsync(row, "CheckedIn"))">Check in</button> }
@if (row.Links.Allows("complete")) { <button data-action="complete" class="button" disabled="@_busy" @onclick="@(() => SetStatusAsync(row, "Completed"))">Complete</button> }
@if (row.Links.Allows("reopen")) { <button data-action="@(row.AppointmentStatus == "CheckedIn" ? "undo-check-in" : "correct")" class="button" disabled="@_busy" @onclick="@(() => SetStatusAsync(row, "Expected"))">@(row.AppointmentStatus == "CheckedIn" ? "Undo check-in" : "Correct")</button> }
@if (row.Links.Allows("noShow")) { <button data-action="no-show" class="button button-danger" disabled="@_busy" @onclick="@(() => SetStatusAsync(row, "NoShow"))">No-show</button> }
else if (row.AppointmentStatus == "Expected") { <span class="hint">No-show is available after the event ends</span> }
</span></td>
</tr>
}
</tbody>
</table></div>
}
}
</section>
