@page "/events/negotiate"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Negotiation board</PageTitle>
<section class="page event-board" aria-labelledby="negotiation-heading" aria-busy="@(_loading || _busy ? "true" : "false")">
<div class="page-header"><div><span class="eyebrow">Manager</span><h1 id="negotiation-heading">Negotiation@(_scopeTypeName is not null ? $" — {_scopeTypeName} (your type)" : "")</h1></div>
@if (_reference?.CollectionLinks.Allows("proposeEvent") == true) { <button data-action="propose" class="button button-primary" @onclick="OpenDialog">Propose event</button> }</div>
@if (_error is not null) { <Banner Variant="BannerVariant.Error" Message="@_error" Retry="LoadAsync" /> }
@if (_notice is not null) { <Banner Variant="BannerVariant.Info" Message="@_notice" /> }
<h2>Open proposals</h2>
@if (_loading) { <p role="status">Loading…</p> }
else if (_proposals.Count == 0) { <p>No open proposals for your type.</p> }
else
{
<div class="table-wrap"><table>
<thead><tr><th scope="col">Location</th><th scope="col">When</th><th scope="col">Types</th><th scope="col">Accepted</th><th scope="col">You</th><th scope="col">Actions</th></tr></thead>
<tbody>
@foreach (var proposal in _proposals)
{
<tr>
<td data-label="Location">@proposal.LocationName</td>
<td data-label="When"><EventTime Value="@proposal.Time" /></td>
<td data-label="Types"><span class="chip-row">@foreach (var type in proposal.Types.OrderBy(x => x.Code, StringComparer.Ordinal)) { <TypeChip Code="@type.Code" Name="@type.Name" /> }</span></td>
<td data-label="Accepted">@proposal.AcceptedTypeCount of @proposal.ListedTypeCount</td>
<td data-label="You">
@if (proposal.AcceptedByMe)
{
<input type="number" name="acceptHeadcount" value="@proposal.MyAcceptedHeadcount" readonly aria-label="Your accepted headcount" />
}
else
{
<input type="number" name="acceptHeadcount" min="1" placeholder="—" aria-label="Your headcount" value="@AcceptHeadcountFor(proposal.Id)" @onchange="e => SetAcceptHeadcount(proposal.Id, e.Value?.ToString())" />
}
</td>
<td data-label="Actions"><span class="row-actions">
@if (proposal.Links.Allows("accept")) { <button data-action="accept" class="button" disabled="@_busy" @onclick="() => AcceptAsync(proposal)">Accept</button> }
@if (proposal.Links.Allows("withdrawAcceptance")) { <button data-action="withdraw-acceptance" class="button" disabled="@_busy" @onclick="() => WithdrawAcceptanceAsync(proposal)">Withdraw acceptance</button> }
@if (proposal.Links.Allows("withdraw")) { <button data-action="withdraw-proposal" class="button button-danger" disabled="@_busy" @onclick="() => WithdrawProposalAsync(proposal)">Withdraw proposal</button> }
</span></td>
</tr>
}
</tbody>
</table></div>
@if (_proposalsCursor is not null) { <button class="button" disabled="@_busy" @onclick="LoadMoreProposalsAsync">Load more</button> }
}
<h2>Confirmed events</h2>
@if (_loading) { <p role="status">Loading…</p> }
else if (_events.Count == 0) { <p>No confirmed events for your type.</p> }
else
{
<div class="table-wrap"><table>
<thead><tr><th scope="col">Location</th><th scope="col">When</th><th scope="col">Capacity</th></tr></thead>
<tbody>
@foreach (var evt in _events)
{
<tr>
<td data-label="Location">@evt.LocationName</td>
<td data-label="When"><EventTime Value="@evt.Time" /></td>
<td data-label="Capacity">
@foreach (var capacity in evt.Capacities)
{
<div class="capacity-row"><TypeChip Code="@capacity.Code" Name="@capacity.Name" />
<span>Total <input type="number" name="totalHeadcount" min="0" aria-label="@($"Total headcount for {capacity.Name}")" value="@CapacityInputFor(evt.Id, capacity)" @onchange="e => SetCapacityInput(evt.Id, capacity.AppointmentTypeId, e.Value?.ToString())" /></span>
<span>Remaining @capacity.RemainingCapacity</span>
@if (capacity.Links.Allows("adjust")) { <button data-action="save-capacity" class="button" disabled="@_busy" @onclick="() => SaveCapacityAsync(evt, capacity)">Save</button> }
@if (CapacityErrorFor(evt.Id, capacity.AppointmentTypeId) is { } capacityError) { <p class="hint" role="alert">@capacityError</p> }
</div>
}
</td>
</tr>
}
</tbody>
</table></div>
@if (_eventsCursor is not null) { <button class="button" disabled="@_busy" @onclick="LoadMoreEventsAsync">Load more</button> }
}
@if (_dialog is not null)
{
<section class="card" aria-labelledby="propose-heading"><h2 id="propose-heading">Propose event</h2>
<label class="field">Location<LocationPicker Mode="LocationPickerMode.Single" Options="@LocationOptions" SelectedIds="@([_dialog.LocationId])" SelectedIdsChanged="ids => _dialog.LocationId = ids.FirstOrDefault(_dialog.LocationId)" /></label>
<p class="hint">@SelectedZoneId</p>
<label class="field">Date<input name="date" type="date" @bind="_dialog.Date" /></label>
@FieldError("date")
<label class="field">Start<input name="start" type="time" @bind="_dialog.Start" @bind:format="HH:mm" /></label>
@FieldError("startTime")
<label class="field">Duration (minutes)<input name="duration" type="number" min="15" max="720" step="15" @bind="_dialog.DurationMinutes" /></label>
@FieldError("durationMinutes")
<p class="hint">@EndPreview</p>
<TypePicker Options="@TypeOptions" CallerTypeId="@_reference!.CallerAppointmentTypeId" SelectedIds="@_dialog.TypeIds" SelectedIdsChanged="ids => _dialog.TypeIds = ids" />
@FieldError("appointmentTypeIds")
<label class="field">Your headcount<input name="headcount" type="number" min="1" @bind="_dialog.Headcount" /></label>
@FieldError("headcount")
<div class="row-actions"><button class="button" @onclick="CloseDialog">Cancel</button><button data-action="submit-proposal" class="button button-primary" disabled="@_busy" @onclick="SubmitProposalAsync">Propose</button></div></section>
}
</section>
